{
  "Transport": "stdio",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "Providers": {
    "Smhi": {
      "BaseUrl": "https://opendata-download-metfcst.smhi.se",
      "UserAgent": "McpServerTemplate/1.0-dev"
    },
    "SmhiObs": {
      "BaseUrl": "https://opendata-download-metobs.smhi.se",
      "UserAgent": "McpServerTemplate/1.0-dev"
    },
    "Enabled": [
      "Smhi",
      "SmhiObs",
      "JsonPlaceholder"
    ]
  },
  "Development": {
    "DevPrincipal": {
      "IdentityProvider": "corp",
      "Subject": "dev-user",
      "ClientId": "dev-ide",
      "Scopes": [
        "weather:read",
        "observations:read",
        "demo:read",
        "demo:write"
      ]
    }
  }
}
