<Project Sdk="Microsoft.NET.Sdk">

  <!-- contract-005 · G-2 — the end-to-end suite. It has no ProjectReference to the product or to any
       test host: it sees the server only as a client and an operator would, through the image's
       network edges, its logs and its exit codes. The Testing library it references holds the test
       PKI and token minting and itself references nothing of the product. xUnit 2.9.3, as the fast
       suite, and its own CI job (G-14), so the fast suite stays fast. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="Testcontainers" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpServerTemplate.Testing\McpServerTemplate.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- contract-005 · G-17 round 1 (FLA-R1-02) — at most 4 test classes at once, whatever the machine. xUnit ran as many as
       the machine has cores (32 on the development machine), and every class running holds its server and what its test
       starts beside it on the run's network, whose dynamic range holds 31 containers (E2ENetwork.DynamicAddresses): there
       the range was seen full. 4 is CI's runner's own core count, the one configuration the job's budget was measured on,
       and with it a run holds at most 16 of the 31 (the five shared services, LimitsTests' five, and two for each of three
       other classes). "conservative" is xUnit 2.9's default, named because the bound rests on it: a class counts against
       the limit from its start to its end, awaits included. -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
